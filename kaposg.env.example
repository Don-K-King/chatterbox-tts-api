# ============================================================================
# Chatterbox TTS API — Ihre Konfiguration
# ============================================================================
# Diese Datei enthält alle Werte, die Sie für den Betrieb in Ihrer Umgebung
# anpassen müssen.
#
# So gehen Sie vor:
#
#   1. Diese Vorlage kopieren:
#        cp kaposg.env.example kaposg.env
#
#   2. Werte unten anpassen.
#
#   3. Stack in Portainer deployen:
#        Stacks → Add stack → Name "evido-chatterbox"
#        → docker-compose.yml hochladen
#        → Im Block "Environment variables" auf
#          "Load variables from .env file" klicken und kaposg.env hochladen
#        → Deploy the stack
#
# Einmalige Vorbereitung Ihrer Umgebung (vor dem ersten Deploy):
#
#   a) Overlay-Netzwerk "evido-chatterbox" anlegen
#      ----------------------------------------------------------------------
#      In Portainer:
#         1. Linke Sidebar → Networks → "+ Add network"
#         2. Name:    evido-chatterbox
#         3. Driver:  overlay
#         4. Option "Enable manual container attachment" aktivieren
#         5. "Create the network" klicken.
#
#      Alternativ per CLI:
#         docker network create --driver overlay --attachable evido-chatterbox
#
#   b) Registry "dreg.lexo.ch" in Portainer hinterlegen
#      (falls noch nicht von einem anderen Stack erledigt)
#
#   c) Chatterbox-Node mit Label markieren
#      ----------------------------------------------------------------------
#      Der Service wird per Constraint auf den Node mit Label
#      `chatterbox=ds01` gepinnt. Vom Swarm-Manager aus:
#
#         docker node update --label-add chatterbox=ds01 ds01
#
#      In Portainer alternativ: Swarm → Klick auf den Node → bei "Labels"
#      einen Eintrag `chatterbox = ds01` hinzufügen → "Apply changes".
#
#   d) (Optional, GPU-Betrieb) NVIDIA-Container-Runtime auf dem Chatterbox-Node
#      ----------------------------------------------------------------------
#      Falls Sie später auf GPU umstellen wollen, siehe die GPU-PROD Marker
#      in der docker-compose.yml und installieren Sie zusätzlich
#      nvidia-container-toolkit + setzen Sie default-runtime: nvidia in
#      /etc/docker/daemon.json (analog zum Whisper-Setup).
# ============================================================================


# ----------------------------------------------------------------------------
# Image-Versionen (OPTIONAL)
# ----------------------------------------------------------------------------
# Standardmässig wird das Tag "latest" verwendet. Für reproduzierbare
# Deployments können Sie hier auf einen konkreten Datums-Tag pinnen.
#
# CHATTERBOX_IMAGE_TAG=26-04-10
# CHATTERBOX_FRONTEND_IMAGE_TAG=26-04-10


# ----------------------------------------------------------------------------
# Authentifizierung (OPTIONAL)
# ----------------------------------------------------------------------------
# Bearer-Token, mit dem Aufrufe an die TTS-API abgesichert werden.
# Leer lassen, wenn der Service nur über das interne Docker-Netzwerk
# erreichbar ist und keine zusätzliche Authentifizierung benötigt wird.

CHATTERBOX_AUTH_TOKEN=


# ----------------------------------------------------------------------------
# Modell-Download-Modus
# ----------------------------------------------------------------------------
# Steuert, ob der Service Modelle live von Hugging Face nachladen darf.
#
#   false → Service darf Modelle aus dem Internet ziehen. Erforderlich beim
#           Erst-Rollout, damit das ~1.5 GB grosse Modell einmalig in das
#           Cache-Volume geladen wird.
#   true  → Lockdown. Service nutzt nur, was bereits im Cache liegt.
#           Empfohlen im Regelbetrieb.

CHATTERBOX_OFFLINE_MODE=false


# ----------------------------------------------------------------------------
# Frontend (OPTIONAL)
# ----------------------------------------------------------------------------
# Das React-Frontend ist standardmässig DEAKTIVIERT (Replicas=0). Es ist nicht
# zwingend für den evido-Stack nötig — die TTS-API wird vom evido-Backend
# direkt im internen Netzwerk angesprochen.
#
# Falls Sie das Frontend für lokales Voice-Management/Testing brauchen:
# Wert auf 1 setzen. Es lauscht dann auf Host-Port 4321.

CHATTERBOX_FRONTEND_REPLICAS=0


# ----------------------------------------------------------------------------
# GPU-Betrieb (für später)
# ----------------------------------------------------------------------------
# Im aktuellen CPU-Test-Modus nicht relevant. Wenn Sie auf GPU umstellen:
# Die folgende Variable füllen UND in der docker-compose.yml die
# GPU-PROD-Markers aktivieren.
#
# Die GPU-UUID auf dem Chatterbox-Node mit `nvidia-smi -L` ermitteln.

# CHATTERBOX_GPU_UUID=GPU-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
